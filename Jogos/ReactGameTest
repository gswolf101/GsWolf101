import { useState, useEffect } from 'react';
import './App.css';

// Ideias
// mais minigames
// evento de abrir baú
// pesca
// classes de armas e habilidades de cada classe
// Sistema de mana e magia
//  -  slimeSquad - cria de 1 a 3 slimes que se sacrificam para proteger de ataques do oponente, custa 2 de mana
//  - fortifize - aumenta o dano temporariamente do ataque do jogador por 2 rodadas em 1.5X, custa 1 ou 2 de mana

function App() {

  // ==================== GAME MANAGER ====================
  const [rodada, setRodada] = useState(0);
  const [turno, setTurno] = useState(0);
  const [statusJogo, setStatusJogo] = useState("start");
  const [interfaceDeBatalha, setInterfaceDeBatalha] = useState("inicial");
  const [dia, setDia] = useState(0);
  const [logAtaques, setLogAtaques] = useState([]);
  const [feiticoSelecionado, setFeiticoSelecionado] = useState(null);
  const [palavraDigitada, setPalavraDigitada] = useState("");
  const [inimigosRestantes, setInimigosRestantes] = useState(1);
  const [dificuldade, setDificuldade] = useState(1);

  // ==================== MÓVEIS DA CASA ====================
  const [camaLevel, setCamaLevel] = useState(1);
  const recuperacaoCama = [0, 0.35, 0.45, 0.6];

  // ==================== JOGADOR ====================
  const [nomeJogador, setNomeJogador] = useState("Guest");
  const [vidaJogador, setVidaJogador] = useState(20);
  const [vidaMaximaJogador, setVidaMaximaJogador] = useState(20);
  const [levelJogador, setLevelJogador] = useState(0);
  const [xpNecessario, setXpNecessario] = useState(5);
  const [xpAtual, setXpAtual] = useState(0);
  const [armaEquipada, setArmaEquipada] = useState(""); // "adaga velha" | "adaga primitiva" | ""
  const [manaJogador, setManaJogador] = useState(5);
  const [maxManaJogador, setMaxManaJogador] = useState(5);
  const [invocacoes, setInvocacoes] = useState(0);
  const [buffDano, setBuffDano] = useState(1);
  const [buffRodadas, setBuffRodadas] = useState(0);

  // ==================== ITENS ====================
  const [pocoes, setPocoes] = useState(3);
  const [moedas, setMoedas] = useState(5);
  const [grimorio, setGrimorio] = useState(false);

  // ==================== ARMAS (formato de classe) ====================
  const [armas, setArmas] = useState({
    adagaVelha: {
      nome: "Adaga Velha",
      id: "adaga velha",
      possui: false,
      dano: [7, 11],
      equipada: false
    },
    adagaPrimitiva: {
      nome: "Adaga Primitiva",
      id: "adaga primitiva",
      possui: false,
      dano: [7, 12],
      equipada: false
    }
  });
  // ==================== FEITIÇOS (formato de classe) ====================
  const [feiticos, setFeiticos] = useState({
    firespear: {
      nome: "firespear",
      recitar: "pyrolance",
      custo_mana: "2",
      dano: [10, 18],
      aprendido: false,
      tipo: "ataque",
    },

    slimeSquad: {
      nome: "slimesquad",
      recitar: "limus",
      custo_mana: "2",
      invocacao: [1, 3], //vai ser usado como quantidade de slimes invocados
      aprendido: false,
      tipo: "invocacao",
    },

    fortifize: {
      nome: "fortifize",
      recitar: "fortis",
      custo_mana: "1",
      multiplicador: 1.5,
      duracao: 2,
      aprendido: false,
      tipo: "buff_ataque",
    },
  })

  // ==================== INIMIGOS (formato de classe) ====================
  const [inimigos] = useState([
    {
      nome: "Lobo",
      vida: 15,
      ataques: [
        { nome: "Arranhão", minimo: 6, maximo: 8 },
        { nome: "Mordida", minimo: 4, maximo: 7 }
      ],
      dropMoedasMax: 10,
      dropRaro: "",
      chanceDropRaro: 0,
      dropXP: 2
    },
    {
      nome: "Slime",
      vida: 10,
      ataques: [
        { nome: "Pancada", minimo: 4, maximo: 5 },
        { nome: "Empurrão", minimo: 2, maximo: 3 }
      ],
      dropMoedasMax: 8,
      dropRaro: "cristal de cura",
      chanceDropRaro: 8,
      dropXP: 1
    },
    {
      nome: "Goblin",
      vida: 18,
      ataques: [
        { nome: "Soco Rápido", minimo: 4, maximo: 7 },
        { nome: "Pancada", minimo: 3, maximo: 4 }
      ],
      dropMoedasMax: 15,
      dropRaro: "adaga primitiva",
      chanceDropRaro: 8,
      dropXP: 2
    },
    {
      nome: "Javali",
      vida: 14,
      ataques: [
        { nome: "Investida", minimo: 5, maximo: 9 },
        { nome: "Mordida", minimo: 4, maximo: 7 }
      ],
      dropMoedasMax: 12,
      dropRaro: "",
      chanceDropRaro: 0,
      dropXP: 2
    }
  ]);

  // ==================== OPONENTE ATUAL ====================
  const [indiceOponenteAtual, setIndiceOponenteAtual] = useState(0);
  const [nomeOponente, setNomeOponente] = useState("");
  const [vidaOponente, setVidaOponente] = useState(1);

  // ==================== ATAQUES BÁSICOS DO JOGADOR ====================
  const ataqueBasico = [5, 10]; // Soco

  // ==================== FUNÇÕES UTILITÁRIAS ====================
  function randint(min, max) {
    return Math.floor(Math.random() * (max - min + 1)) + min;
  }

  function wait(tempo) {
    return new Promise((resolve) => setTimeout(resolve, tempo * 1000));
  }

  // ==================== BARRA DE VIDA ====================
  function barraDeVida(vidaAtual, vidaMaxima) {
    const max = vidaMaxima || 1;
    const porcentagem = Math.max(0, Math.min(100, (vidaAtual / max) * 100));

    return (
      <div style={{ display: "flex", alignItems: "center", gap: "10px", margin: "8px 0" }}>
        <div style={{
          width: "250px",
          height: "24px",
          backgroundColor: "#1f2937",
          border: "2px solid #4b5563",
          borderRadius: "6px",
          overflow: "hidden"
        }}>
          <div style={{
            width: `${porcentagem}%`,
            height: "100%",
            backgroundColor: vidaAtual > max * 0.35 ? "#22c55e" : "#ef4444",
            transition: "width 0.4s ease"
          }} />
        </div>
        <span style={{ fontFamily: "monospace", minWidth: "85px" }}>
          {vidaAtual} / {max}
        </span>
      </div>
    );
  }

  // ==================== GERAR BATALHA ====================
  function gerarBatalha(quantidade = 1) {
    const indice = randint(0, inimigos.length - 1);
    const inimigo = inimigos[indice];

    setIndiceOponenteAtual(indice);
    setInimigosRestantes(quantidade);
    setNomeOponente(inimigo.nome);
    setVidaOponente(inimigo.vida * dificuldade);
    setTurno(0);
    setInterfaceDeBatalha("inicial");
  }

  function mudarTurno() {
    setTurno((atual) => {
      const novo = atual === 0 ? 1 : 0;

      id (novo === 0) {
        setInterfaceDeBatalha("inicial")
      }

    })
    
  }

  // ==================== ATAQUES ====================
  function inimigoAtacar() {
    if (vidaJogador <= 0 || vidaOponente <= 0) return;

    const inimigo = inimigos[indiceOponenteAtual];
    const ataqueEscolhido = inimigo.ataques[randint(0, inimigo.ataques.length - 1)];
    const dano = randint(ataqueEscolhido.minimo, ataqueEscolhido.maximo);

    setLogAtaques((log) => [`${inimigo.nome} usou ${ataqueEscolhido.nome}`, ...log]);
    setVidaJogador((vidaAtual) => Math.max(0, vidaAtual - dano));
    setInterfaceDeBatalha("esperando");

    wait(1).then(() => {
      if (vidaJogador > 0) {
        mudarTurno();
      }
    });
  }

  function tentarRecitar() {
    const palavra = palavraDigitada.trim().toLowerCase();

    // Encontrar o feitiço pela palavra recitada
    const feitico = Object.values(feiticos).find(
      (f) => f.recitar.toLowerCase() === palavra
    )

    if (!feiticos) {
      setLogAtaques((log) => ["Nada acontece...", ...log])
    }
    return
    }

    if (feitico.tipo === "ataque") {
      feitiçoAtaque(feitico);
    } else if (feitico.tipo === "invocacao") {
      feitiçoInvocacao(feitico);
    } else if (feitico.tipo === "buff_ataque") {
      feitiçoBuffAtaque(feitico);
    }

    setPalavraDigitada("");
  }

  function feiticoBuffAtaque(feitico) {
    if (!gastarMana(Number(feitico.custo_mana))) return;

    setBuffDano(feitico.multiplicador);
    setBuffRodadas(feitico.duracao);

    setLogAtaques((log) => [
      "Fortifize te deixa mais forte!!", ...log
    ]);
    setInterfaceDeBatalha("esperando")

  }
  function darDrops(indice) {
    const inimigo = inimigos[indice];
    const DropMoedas = randint(3, inimigo.dropMoedasMax);
    const xpDropado = randint(1, inimigo.dropXP);

    setMoedas((m) => m + DropMoedas);
    setXpAtual((xp) => xp + xpDropado);
    setLogAtaques((log) => [`${DropMoedas} moedas e ${xpDropado} XP`, ...log]);

    if (inimigo.chanceDropRaro > 0 && randint(1, 10) <= inimigo.chanceDropRaro) {
      const itemDropado = inimigo.dropRaro;

      if (itemDropado === "adaga primitiva" && !armas.adagaPrimitiva.possui) {
        setArmas((prev) => ({
          ...prev,
          adagaPrimitiva: { ...prev.adagaPrimitiva, possui: true }
        }));
        setLogAtaques((log) => ["Você encontrou uma Adaga Primitiva!!", ...log]);
      } else if (itemDropado === "cristal de cura") {
        setPocoes((p) => p + 1);
        setLogAtaques((log) => ["Você encontra um cristal de cura!!", ...log]);
      }
    }
  }

  function atacar(ataque, nomeDoAtaque) {
    const danoCausado = randint(ataque[0], ataque[1]);

    setLogAtaques((log) => [`${nomeJogador} usou ${nomeDoAtaque}`, ...log]);
    setVidaOponente((vidaAtual) => Math.max(0, vidaAtual - danoCausado));
    setInterfaceDeBatalha("esperando");

    wait(1).then(() => {
      mudarTurno();
      setRodada((r) => r + 1);

      // Nota: usamos o valor atualizado aproximado
      if (vidaOponente - danoCausado > 0 && vidaJogador > 0) {
        inimigoAtacar();
      }
    });
  }

  function usarPocao() {
    if (pocoes <= 0) return;

    const cura = randint(10, 20);
    setVidaJogador((vidaAtual) => Math.min(vidaAtual + cura, vidaMaximaJogador));
    setPocoes((p) => p - 1);
    setInterfaceDeBatalha("esperando");
    setLogAtaques((log) => [`${nomeJogador} usou uma Poção (+${cura} HP)`, ...log]);

    wait(0.8).then(() => {
      mudarTurno();
      if (vidaJogador > 0 && vidaOponente > 0) {
        inimigoAtacar();
      } else {
        setInterfaceDeBatalha("inicial");
      }
    });
  }

  function passarDia() {
    setDia((d) => d + 1);
    setVidaJogador((vidaAtual) => {
      const multiplicador = recuperacaoCama[camaLevel] || 1.0;
      const vidaParaRecuperar = Math.floor(vidaMaximaJogador * multiplicador);
      return Math.min(vidaAtual + vidaParaRecuperar, vidaMaximaJogador);
    });
  }

  function gastarMana(custo) {
    if (manaJogador < custo) {
      setLogAtaques((log) => ["Mana insuficiente...", ...log]);
      return false;
    } else {
      setManaJogador((mana) => mana - custo);
      return true;
    }
  }

  // ==================== COMPRAS ====================
  function upgradeCama(preco) {
    if (moedas >= preco) {
      setMoedas((m) => m - preco);
      setCamaLevel((l) => l + 1);
    } else {
      alert("Vendedor: Sem grana, sem itens");
    }
  }

  function comprarItemAcumulavel(setItem, preco, quantidade) {
    if (moedas >= preco) {
      setMoedas((m) => m - preco);
      setItem((i) => i + quantidade);
    } else {
      alert("Sem grana suficiente!");
    }
  }

  function comprarArma(chaveArma, preco) {
    if (moedas >= preco && !armas[chaveArma].possui) {
      setMoedas((m) => m - preco);
      setArmas((prev) => ({
        ...prev,
        [chaveArma]: { ...prev[chaveArma], possui: true }
      }));
    } else {
      alert("Vendedor: Sem grana, sem itens");
    }
  }

  function comprarSpell(nomeFeitico, preco) {
    if (moedas >= preco) {
      if (grimorio) {
        setMoedas((m) => m - preco);
        setFeiticos(feiticosAnteriores => ({
          ...feiticosAnteriores,

          [nomeFeitico]: {
            ...feiticosAnteriores[nomeFeitico],
            aprendido: true
          }
        }))
      } else {
        alert("Vendedor: Você não acha que deveria possuir um grimório primeiro?");
      }
    } else {
      alert("Vendedor: Sem grana, sem itens");
    }
  }

  // ==================== EFFECTS ====================
  useEffect(() => {
    if (xpAtual >= xpNecessario && xpNecessario > 0) {
      setLevelJogador((l) => l + 1);
      setVidaMaximaJogador((v) => Math.floor(v * 1.2));
      setXpNecessario((xp) => Math.floor(xp * 1.5));
      setXpAtual(0);
    }
  }, [xpAtual, xpNecessario]);

  useEffect(() => {
    if (vidaOponente <= 0 && vidaJogador > 0) {

      if (inimigosRestantes > 1) {
        setInimigosRestantes((q) => q - 1);
        setTimeout(() => {
          const indice = randint(0, inimigos.length - 1);
          const inimigo = inimigos[indice];
          setIndiceOponenteAtual(indice);
          setNomeOponente(inimigo.nome);
          setVidaOponente(inimigo.vida * dificuldade);
          setTurno(0);
          setInterfaceDeBatalha("inicial");
          setLogAtaques((log) => [`✦ Um novo ${inimigo.nome} apareceu! ✦`, ...log]);
        }, 1000);
      } else {
        darDrops(indiceOponenteAtual);
        wait(2)
        setInterfaceDeBatalha("vitoria")
        setLogAtaques((Log) => [""])
        setTurno(0);
      }
    } else if (vidaJogador <= 0) {
      setInterfaceDeBatalha("derrota");
      setTurno(0);
    }
  }, [vidaOponente, vidaJogador]);

  // ==================== JSX ====================
  return (
    <div className="App">
      {statusJogo === "start" && (
        <div className="tela_inicial">
          <h1>Bem-vindo(a)!</h1>
          <p>Por favor insira seu nome antes de continuar:</p>
          <input
            type="text"
            value={nomeJogador}
            onChange={(e) => setNomeJogador(e.target.value)}
          />
          <button onClick={() => {
            setStatusJogo("batalhando");
            gerarBatalha(1);
          }}>
            Começar
          </button>
        </div>
      )}

      {/* ===================== BATALHA ===================== */}
      {statusJogo === "batalhando" && (
        <div className="Tela_de_batalha">
          <div className="arena">
            {/* Lado do Inimigo */}
            <div className="area_inimigo">
              <div className="informacoes_inimigo">
                <p className="nome_inimigo">{nomeOponente}</p>
                {barraDeVida(
                  vidaOponente,
                  inimigos[indiceOponenteAtual]?.vida * dificuldade || 1
                )}
              </div>
            </div>

            {/* Lado do Jogador */}
            <div className="area_player">
              <div className="informacoes_player">
                <p className="nome_player">{nomeJogador}</p>
                {barraDeVida(vidaJogador, vidaMaximaJogador)}
              </div>
            </div>
          </div>

          <div className="interface_batalha">
            {interfaceDeBatalha !== "vitoria" && interfaceDeBatalha !== "derrota" && (
              <>
                {interfaceDeBatalha === "inicial" && turno === 0 && (
                  <div className="comandos">
                    <button onClick={() => setInterfaceDeBatalha("atacar")}>ATACAR</button>
                    <button onClick={() => setInterfaceDeBatalha("itens")}>ITENS</button>
                    <button onClick={() => setInterfaceDeBatalha("recitar")}>RECITAR</button>
                  </div>
                )}

                {interfaceDeBatalha === "atacar" && turno === 0 && (
                  <div className="comandos_ataques">
                    <button onClick={() => atacar(ataqueBasico, "Soco")}>
                      Soco
                    </button>

                    {armaEquipada === "adaga primitiva" && armas.adagaPrimitiva.possui && (
                      <button onClick={() => atacar(armas.adagaPrimitiva.dano, "Corte Primitivo")}>
                        Corte Primitivo
                      </button>
                    )}

                    {armaEquipada === "adaga velha" && armas.adagaVelha.possui && (
                      <button onClick={() => atacar(armas.adagaVelha.dano, "Corte")}>
                        Corte
                      </button>
                    )}

                    <button onClick={() => setInterfaceDeBatalha("inicial")}>Voltar</button>
                  </div>
                )}

                {interfaceDeBatalha === "itens" && (
                  <div className="comandos_itens">
                    {pocoes > 0 && (
                      <button onClick={usarPocao}>Poção ({pocoes})</button>
                    )}
                    <button onClick={() => setInterfaceDeBatalha("inicial")}>Voltar</button>
                  </div>
                )}

                <div className="log_batalha">
                  <h4>Log</h4>
                  {logAtaques.map((log, index) => (
                    <p key={index}>{log}</p>
                  ))}
                </div>

                {interfaceDeBatalha === "recitar" && (
                  <div>
                    {/* Área de feitiços ainda vazia */}
                    <button onClick={() => setInterfaceDeBatalha("inicial")}>Voltar</button>
                  </div>
                )}
              </>
            )}

            {interfaceDeBatalha === "vitoria" && (
              <div className="resultado_vitoria">
                <h1>Você venceu!</h1>
                <button onClick={() => {
                  setStatusJogo("lobby");
                  setInterfaceDeBatalha("inicial");
                  setTurno(0);
                  setRodada(0);
                  setLogAtaques([]);
                }}>
                  Voltar para a vila
                </button>
              </div>
            )}

            {interfaceDeBatalha === "derrota" && (
              <div className="resultado_derrota">
                <h1>Você foi derrotado...</h1>
              </div>
            )}
          </div>
        </div>
      )}

      {/* LOBBY */}
      {statusJogo === "lobby" && (
        <div className="tela_lobby">
          <p>{nomeJogador}</p>
          <p>Level: {levelJogador}</p>
          <p>Vida: {vidaJogador} / {vidaMaximaJogador}</p>
          <p>Moedas: {moedas}</p>
          <button onClick={() => setStatusJogo("casa")}>Casa</button>
          <button onClick={() => setStatusJogo("floresta")}>Floresta</button>
          <button onClick={() => setStatusJogo("loja")}>Loja</button>
        </div>
      )}

      {/* FLORESTA */}
      {statusJogo === "floresta" && (
        <div className="tela_floresta">
          <button onClick={() => setStatusJogo("lobby")}>Voltar</button>
          <p>O QUÃO FUNDO DEVO IR NA FLORESTA??</p>
          <button onClick={() => {
            setDificuldade(1);
            setStatusJogo("batalhando");
            gerarBatalha(randint(1, 2));
          }}>
            Bosque
          </button>
          <button onClick={() => {
            setDificuldade(2);
            setStatusJogo("batalhando");
            gerarBatalha(randint(1, 3));
          }}>
            Campo de pinheiros
          </button>
          <button onClick={() => {
            setDificuldade(3);
            setStatusJogo("batalhando");
            gerarBatalha(randint(3, 5));
          }}>
            Profundezas
          </button>
        </div>
      )}

      {/* CASA */}
      {statusJogo === "casa" && (
        <div className="tela_casa">
          <button onClick={() => setStatusJogo("lobby")}>Voltar para aldeia</button>
          <p>Casa</p>
          <p>Dia: {dia}</p>
          <p>Vida: {vidaJogador}/{vidaMaximaJogador}</p>
          <button onClick={passarDia}>Descansar por hoje</button>
          <button onClick={() => setStatusJogo("casa-inventario")}>Inventário</button>
        </div>
      )}

      {/* INVENTÁRIO */}
      {statusJogo === "casa-inventario" && (
        <div className="tela_inventario">
          <button onClick={() => setStatusJogo("casa")}>Voltar</button>
          <h2>Inventário</h2>

          {armas.adagaPrimitiva.possui && (
            <div>
              <p>
                <strong>{armas.adagaPrimitiva.nome}</strong> - Dano:{" "}
                {armas.adagaPrimitiva.dano[0]}-{armas.adagaPrimitiva.dano[1]}
              </p>
              <button
                onClick={() => setArmaEquipada("adaga primitiva")}
                disabled={armaEquipada === "adaga primitiva"}
              >
                {armaEquipada === "adaga primitiva" ? "✓ Equipada" : "Equipar"}
              </button>
            </div>
          )}

          {armas.adagaVelha.possui && (
            <div>
              <p>
                <strong>{armas.adagaVelha.nome}</strong> - Dano:{" "}
                {armas.adagaVelha.dano[0]}-{armas.adagaVelha.dano[1]}
              </p>
              <button
                onClick={() => setArmaEquipada("adaga velha")}
                disabled={armaEquipada === "adaga velha"}
              >
                {armaEquipada === "adaga velha" ? "✓ Equipada" : "Equipar"}
              </button>
            </div>
          )}
        </div>
      )}

      {/* LOJA */}
      {statusJogo === "loja" && (
        <div className="tela_loja">
          <h1>Loja</h1>
          <p>Moedas: <strong>{moedas}</strong></p>

          <button onClick={() => comprarItemAcumulavel(setPocoes, 5, 1)}>
            Comprar Poção (5 moedas)
          </button>

          {!armas.adagaVelha.possui && (
            <button onClick={() => comprarArma("adagaVelha", 10)}>
              Adaga Velha (10 moedas)
            </button>
          )}

          {!grimorio && dia >= 5 && (
            <button onClick={() => {
              if (moedas >= 25) {
                setMoedas((m) => m - 25);
                setGrimorio(true);
              } else {
                alert("Vendedor: Sem grana, sem itens");
              }
            }}>
              Grimório (25 moedas)
            </button>
          )}

          {grimorio && !feiticos.slimeSquad.aprendido && (
            <button onClick={() => comprarSpell("slimeSquad", 30)}>
              Pergaminho de Slimes (30 moedas)
            </button>
          )}

          <br /><br />
          <button onClick={() => setStatusJogo("lobby")}>Voltar</button>
        </div>
      )}
    </div>
  );
}

export default App;
