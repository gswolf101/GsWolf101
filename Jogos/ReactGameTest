import { useState, useEffect } from 'react';
import './App.css';

// Ideias futuras:
// - mais minigames
// - seleção de personagens
// - evento de abrir baú
// - pesca
// - classes de armas e habilidades de cada classe
// - Sistema de mana e magia - Feito
//   - slimeSquad → cria de 1 a 3 slimes que se sacrificam para proteger de ataques (custa 2 de mana)
//   - fortifize → aumenta o dano do ataque do jogador em 1.5x por 2 rodadas (custa 1 ou 2 de mana)
//   - firespear → ataque mágico que causa de 10 a 18 de dano (custa 2 de mana)
// - Sistema de level e XP - Feito
// - Sistema de drops de moedas e XP - Feito
// - Sistema de drops de itens - Feito
// - Sistema de drops raros - Feito

function App() {
  // ==================== GAME MANAGER ====================
  const skins = [
    { id: "skin1", imagem: "/images/jogador1.png" },
    { id: "skin2", imagem: "/images/jogador2.png" },
    { id: "skin3", imagem: "/images/jogador3.png" },
  ];

  const [skinId, setSkinId] = useState("skin1");
  const [rodada, setRodada] = useState(0);
  const [turno, setTurno] = useState(0);
  const [statusJogo, setStatusJogo] = useState("start");
  const [interfaceDeBatalha, setInterfaceDeBatalha] = useState("inicial");
  const [dia, setDia] = useState(0);
  const [logAtaques, setLogAtaques] = useState([]);
  const [feiticoSelecionado, setFeiticoSelecionado] = useState(null);
  const [palavraDigitada, setPalavraDigitada] = useState("");
  const [inimigosRestantes, setInimigosRestantes] = useState(1);
  const [dificuldade, setDificuldade] = useState(1);
  const [mostrarAtaqueVisual, setMostrarAtaqueVisual] = useState(false);

  // ==================== GAME IMAGENS ====================
  const [imagemCristal] = useState("/images/cristal.png");
  const [imagemAdagaPrimitiva] = useState("/images/adaga_primitiva.png");
  const [imagemAdagaVelha] = useState("/images/adaga_velha.png");

  // ==================== MÓVEIS DA CASA ====================
  const [camaLevel, setCamaLevel] = useState(1);
  const recuperacaoCama = [0, 0.35, 0.45, 0.6];

  // ==================== JOGADOR ====================
  const [imagemJogador, setImagemJogador] = useState("");
  const [nomeJogador, setNomeJogador] = useState("Guest");
  const [vidaJogador, setVidaJogador] = useState(20);
  const [vidaMaximaJogador, setVidaMaximaJogador] = useState(20);
  const [levelJogador, setLevelJogador] = useState(0);
  const [xpNecessario, setXpNecessario] = useState(5);
  const [xpAtual, setXpAtual] = useState(0);
  const [armaEquipada, setArmaEquipada] = useState("");
  const [manaJogador, setManaJogador] = useState(5);
  const [maxManaJogador, setMaxManaJogador] = useState(5);
  const [invocacoes, setInvocacoes] = useState(0);
  const [buffDano, setBuffDano] = useState(1);
  const [buffRodadas, setBuffRodadas] = useState(0);
  const [intervaloDescanso, setIntervaloDescanso] = useState(0);

  // ==================== ITENS ====================
  const [cristais, setCristais] = useState(3);
  const [moedas, setMoedas] = useState(5);
  const [grimorio, setGrimorio] = useState(false);

  // ==================== ARMAS ====================
  const [armas, setArmas] = useState({
    adagaVelha: {
      nome: "Adaga Velha",
      id: "adaga velha",
      possui: false,
      dano: [7, 11],
      equipada: false
    },
    adagaPrimitiva: {
      nome: "Adaga Primitiva",
      id: "adaga primitiva",
      possui: false,
      dano: [7, 12],
      equipada: false
    }
  });

  // ==================== FEITIÇOS ====================
  const [feiticos, setFeiticos] = useState({
    firespear: {
      nome: "firespear",
      recitar: "pyrolance",
      custo_mana: "2",
      dano: [10, 18],
      aprendido: false,
      tipo: "ataque"
    },
    slimeSquad: {
      nome: "slimesquad",
      recitar: "limus",
      custo_mana: "2",
      invocacao: [1, 3],
      aprendido: false,
      tipo: "invocacao"
    },
    fortifize: {
      nome: "fortifize",
      recitar: "fortis",
      custo_mana: "1",
      multiplicador: 1.5,
      duracao: 2,
      aprendido: false,
      tipo: "buff_ataque"
    }
  });

  // ==================== INIMIGOS ====================
  const [inimigos] = useState([
    {
      nome: "Lobo",
      vida: 15,
      ataques: [
        { nome: "Arranhão", minimo: 6, maximo: 8 },
        { nome: "Mordida", minimo: 4, maximo: 7 }
      ],
      dropMoedasMax: 10,
      dropRaro: "",
      chanceDropRaro: 0,
      dropXP: 2
    },
    {
      nome: "Slime",
      vida: 10,
      ataques: [
        { nome: "Pancada", minimo: 4, maximo: 5 },
        { nome: "Empurrão", minimo: 2, maximo: 3 }
      ],
      dropMoedasMax: 8,
      dropRaro: "cristal de cura",
      chanceDropRaro: 8,
      dropXP: 1
    },
    {
      nome: "Goblin",
      vida: 18,
      ataques: [
        { nome: "Soco Rápido", minimo: 4, maximo: 7 },
        { nome: "Pancada", minimo: 3, maximo: 4 }
      ],
      dropMoedasMax: 15,
      dropRaro: "adaga primitiva",
      chanceDropRaro: 8,
      dropXP: 2
    },
    {
      nome: "Javali",
      vida: 14,
      ataques: [
        { nome: "Investida", minimo: 5, maximo: 9 },
        { nome: "Mordida", minimo: 4, maximo: 7 }
      ],
      dropMoedasMax: 12,
      dropRaro: "",
      chanceDropRaro: 0,
      dropXP: 2
    }
  ]);

  // ==================== OPONENTE ATUAL ====================
  const [indiceOponenteAtual, setIndiceOponenteAtual] = useState(0);
  const [nomeOponente, setNomeOponente] = useState("");
  const [vidaOponente, setVidaOponente] = useState(1);

  // ==================== ATAQUES BÁSICOS ====================
  const ataqueBasico = [5, 10];

  // ==================== FUNÇÕES UTILITÁRIAS ====================
  function randint(min, max) {
    return Math.floor(Math.random() * (max - min + 1)) + min;
  }

  function wait(tempo) {
    return new Promise((resolve) => setTimeout(resolve, tempo * 1000));
  }

  function adicionarLog(entrada) {
    setLogAtaques((log) => [entrada, ...log]);
  }

  function imagemArmaEquipada() {
    if (armaEquipada === "adaga primitiva") return imagemAdagaPrimitiva;
    if (armaEquipada === "adaga velha") return imagemAdagaVelha;
    return null;
  }

  // ==================== BARRA DE VIDA ====================
  function barraDeVida(vidaAtual, vidaMaxima) {
    const max = vidaMaxima || 1;
    const porcentagem = Math.max(0, Math.min(100, (vidaAtual / max) * 100));

    return (
      <div style={{ display: "flex", alignItems: "center", gap: "10px", margin: "8px 0" }}>
        <div
          style={{
            width: "250px",
            height: "24px",
            backgroundColor: "#1f2937",
            border: "2px solid #4b5563",
            borderRadius: "6px",
            overflow: "hidden"
          }}
        >
          <div
            style={{
              width: `${porcentagem}%`,
              height: "100%",
              backgroundColor: vidaAtual > max * 0.35 ? "#22c55e" : "#ef4444",
              transition: "width 0.4s ease"
            }}
          />
        </div>
        <span style={{ fontFamily: "monospace", minWidth: "85px" }}>
          {vidaAtual} / {max}
        </span>
      </div>
    );
  }

  // Esferas de mana
  function esferasDeMana() {
    const esferas = [];
    for (let i = 0; i < maxManaJogador; i++) {
      esferas.push(
        <span
          key={i}
          className={`mana-esfera ${i < manaJogador ? "mana-esfera-cheia" : "mana-esfera-vazia"}`}
        />
      );
    }
    return <div className="mana-esferas">{esferas}</div>;
  }

  // ==================== VISUAL DE ATAQUE ====================
  function dispararVisualAtaque() {
    setMostrarAtaqueVisual(true);
    wait(1).then(() => setMostrarAtaqueVisual(false));
  }

  // ==================== GERAR BATALHA ====================
  function gerarBatalha(quantidade = 1) {
    const indice = randint(0, inimigos.length - 1);
    const inimigo = inimigos[indice];

    setIndiceOponenteAtual(indice);
    setInimigosRestantes(quantidade);
    setNomeOponente(inimigo.nome);
    setVidaOponente(inimigo.vida * dificuldade);
    setTurno(0);
    setInterfaceDeBatalha("inicial");
    setIntervaloDescanso(0);
    setMostrarAtaqueVisual(false);
  }

  function mudarTurno() {
    setTurno((atual) => {
      const novo = atual === 0 ? 1 : 0;

      if (novo === 0) {
        setInterfaceDeBatalha("inicial");
      }

      return novo;
    });
  }

  // ==================== ATAQUES ====================
  function inimigoAtacar() {
    if (vidaJogador <= 0 || vidaOponente <= 0) return;

    const inimigo = inimigos[indiceOponenteAtual];
    const ataqueEscolhido = inimigo.ataques[randint(0, inimigo.ataques.length - 1)];
    const dano = randint(ataqueEscolhido.minimo, ataqueEscolhido.maximo);

    adicionarLog(`${inimigo.nome} usou ${ataqueEscolhido.nome}`);
    setVidaJogador((vidaAtual) => Math.max(0, vidaAtual - dano));
    setInterfaceDeBatalha("esperando");

    wait(1).then(() => {
      mudarTurno();
    });
  }

  function tentarRecitar() {
    const palavra = palavraDigitada.trim().toLowerCase();

    const feitico = Object.values(feiticos).find(
      (f) => f.recitar.toLowerCase() === palavra
    );

    if (!feitico) {
      adicionarLog("Nada acontece...");
      setPalavraDigitada("");
      setInterfaceDeBatalha("esperando");

      wait(0.8).then(() => {
        mudarTurno();
        if (vidaJogador > 0 && vidaOponente > 0) {
          inimigoAtacar();
        }
      });
      return;
    }

    if (feitico.tipo === "ataque") {
      feiticoAtaque(feitico);
    } else if (feitico.tipo === "invocacao") {
      adicionarLog("Esse feitiço ainda não está pronto...");
      setInterfaceDeBatalha("esperando");
      wait(0.8).then(() => {
        mudarTurno();
        if (vidaJogador > 0 && vidaOponente > 0) {
          inimigoAtacar();
        }
      });
    } else if (feitico.tipo === "buff_ataque") {
      feiticoBuffAtaque(feitico);
    }

    setPalavraDigitada("");
  }

  function feiticoAtaque(feitico) {
    if (!gastarMana(Number(feitico.custo_mana))) {
      setInterfaceDeBatalha("esperando");
      wait(0.8).then(() => {
        mudarTurno();
        if (vidaJogador > 0 && vidaOponente > 0) {
          inimigoAtacar();
        }
      });
      return;
    }

    atacar(feitico.dano, feitico.nome);
  }

  function feiticoBuffAtaque(feitico) {
    if (!gastarMana(Number(feitico.custo_mana))) {
      setInterfaceDeBatalha("esperando");
      wait(0.8).then(() => {
        mudarTurno();
        if (vidaJogador > 0 && vidaOponente > 0) {
          inimigoAtacar();
        }
      });
      return;
    }

    setBuffDano(feitico.multiplicador);
    setBuffRodadas(feitico.duracao);

    adicionarLog("Fortifize te deixa mais forte!!");
    setInterfaceDeBatalha("esperando");

    wait(0.8).then(() => {
      mudarTurno();
      if (vidaJogador > 0 && vidaOponente > 0) {
        inimigoAtacar();
      }
    });
  }

  function darDrops(indice) {
    const inimigo = inimigos[indice];
    const DropMoedas = randint(3, inimigo.dropMoedasMax);
    const xpDropado = randint(1, inimigo.dropXP);

    setMoedas((m) => m + DropMoedas);
    setXpAtual((xp) => xp + xpDropado);
    adicionarLog(`${DropMoedas} moedas e ${xpDropado} XP`);

    if (inimigo.chanceDropRaro > 0 && randint(1, 10) <= inimigo.chanceDropRaro) {
      const itemDropado = inimigo.dropRaro;

      if (itemDropado === "adaga primitiva" && !armas.adagaPrimitiva.possui) {
        setArmas((prev) => ({
          ...prev,
          adagaPrimitiva: { ...prev.adagaPrimitiva, possui: true }
        }));
        adicionarLog({
          texto: "Você encontrou uma Adaga Primitiva!!",
          imagem: imagemAdagaPrimitiva
        });
      } else if (itemDropado === "cristal de cura") {
        setCristais((c) => c + 1);
        adicionarLog({
          texto: "Você encontra um cristal de cura!!",
          imagem: imagemCristal
        });
      }
    }
  }

  function atacar(ataque, nomeDoAtaque) {
    const base = randint(ataque[0], ataque[1]);
    const danoCausado = Math.floor(base * buffDano);

    dispararVisualAtaque();

    adicionarLog(`${nomeJogador} usou ${nomeDoAtaque}`);
    setVidaOponente((vidaAtual) => Math.max(0, vidaAtual - danoCausado));
    setInterfaceDeBatalha("esperando");

    wait(1).then(() => {
      mudarTurno();
      setRodada((r) => r + 1);

      setBuffRodadas((br) => {
        if (br <= 1) {
          setBuffDano(1);
          return 0;
        }
        return br - 1;
      });

      if (vidaOponente - danoCausado > 0 && vidaJogador > 0) {
        inimigoAtacar();
      }
    });
  }

  function usarCristal() {
    if (cristais <= 0) return;

    const cura = randint(10, 20);
    setVidaJogador((vidaAtual) => Math.min(vidaAtual + cura, vidaMaximaJogador));
    setCristais((c) => c - 1);
    setInterfaceDeBatalha("esperando");
    adicionarLog({
      texto: `${nomeJogador} usou um Cristal de Cura (+${cura} HP)`,
      imagem: imagemCristal
    });

    wait(0.8).then(() => {
      mudarTurno();
      if (vidaJogador > 0 && vidaOponente > 0) {
        inimigoAtacar();
      } else {
        setInterfaceDeBatalha("inicial");
      }
    });
  }

  function usarCristalInventario() {
    if (cristais <= 0) return;

    if (vidaJogador >= vidaMaximaJogador) {
      alert("Sua vida já está cheia!");
      return;
    }

    const cura = randint(10, 20);
    setVidaJogador((vidaAtual) => Math.min(vidaAtual + cura, vidaMaximaJogador));
    setCristais((c) => c - 1);
  }

  function passarDia() {
    if (intervaloDescanso >= 1) {
      alert("Eu ainda não estou cansado...");
    } else {
      setIntervaloDescanso(1);
      setDia((d) => d + 1);
      setVidaJogador((vidaAtual) => {
        const multiplicador = recuperacaoCama[camaLevel] || 1.0;
        const vidaParaRecuperar = Math.floor(vidaMaximaJogador * multiplicador);
        return Math.min(vidaAtual + vidaParaRecuperar, vidaMaximaJogador);
      });
    }
  }

  function gastarMana(custo) {
    if (manaJogador < custo) {
      adicionarLog("Mana insuficiente...");
      return false;
    }

    setManaJogador((mana) => mana - custo);
    return true;
  }

  // ==================== COMPRAS ====================
  function upgradeCama(preco) {
    if (moedas >= preco) {
      setMoedas((m) => m - preco);
      setCamaLevel((l) => l + 1);
    } else {
      alert("Vendedor: Sem grana, sem itens");
    }
  }

  function comprarItemAcumulavel(setItem, preco, quantidade) {
    if (moedas >= preco) {
      setMoedas((m) => m - preco);
      setItem((i) => i + quantidade);
    } else {
      alert("Sem grana suficiente!");
    }
  }

  function comprarArma(chaveArma, preco) {
    if (moedas >= preco && !armas[chaveArma].possui) {
      setMoedas((m) => m - preco);
      setArmas((prev) => ({
        ...prev,
        [chaveArma]: { ...prev[chaveArma], possui: true }
      }));
    } else {
      alert("Vendedor: Sem grana, sem itens");
    }
  }

  function comprarSpell(nomeFeitico, preco) {
    if (moedas >= preco) {
      if (grimorio) {
        setMoedas((m) => m - preco);
        setFeiticos((feiticosAnteriores) => ({
          ...feiticosAnteriores,
          [nomeFeitico]: {
            ...feiticosAnteriores[nomeFeitico],
            aprendido: true
          }
        }));
      } else {
        alert("Vendedor: Você não acha que deveria possuir um grimório primeiro?");
      }
    } else {
      alert("Vendedor: Sem grana, sem itens");
    }
  }

  // ==================== EFFECTS ====================
  useEffect(() => {
    if (xpAtual >= xpNecessario && xpNecessario > 0) {
      setLevelJogador((l) => l + 1);
      setVidaMaximaJogador((v) => Math.floor(v * 1.2));
      setXpNecessario((xp) => Math.floor(xp * 1.5));
      setXpAtual(0);
    }
  }, [xpAtual, xpNecessario]);

  useEffect(() => {
    if (vidaOponente <= 0 && vidaJogador > 0) {
      if (inimigosRestantes > 1) {
        setInimigosRestantes((q) => q - 1);
        setTimeout(() => {
          const indice = randint(0, inimigos.length - 1);
          const inimigo = inimigos[indice];
          setIndiceOponenteAtual(indice);
          setNomeOponente(inimigo.nome);
          setVidaOponente(inimigo.vida * dificuldade);
          setTurno(0);
          setInterfaceDeBatalha("inicial");
          adicionarLog(`✦ Um novo ${inimigo.nome} apareceu! ✦`);
        }, 1000);
      } else {
        darDrops(indiceOponenteAtual);
        wait(2).then(() => {
          setInterfaceDeBatalha("vitoria");
          setLogAtaques([""]);
          setTurno(0);
        });
      }
    } else if (vidaJogador <= 0) {
      setInterfaceDeBatalha("derrota");
      setTurno(0);
    }
  }, [vidaOponente, vidaJogador]);

  // ==================== RENDER DO LOG ====================
  function renderLogItem(log, index) {
    if (typeof log === "string") {
      return (
        <p key={index} className="log-item">
          {log}
        </p>
      );
    }

    if (log && typeof log === "object") {
      return (
        <div key={index} className="log-item log-item-com-imagem">
          {log.imagem && (
            <img
              src={log.imagem}
              alt="item dropado"
              className="log-item-img"
            />
          )}
          <span>{log.texto}</span>
        </div>
      );
    }

    return null;
  }

  // ==================== JSX ====================
  return (
    <div className="App">
      {/* TELA INICIAL */}
      {statusJogo === "start" && (
        <div className="tela_inicial">
          <h1>Bem-vindo(a)!</h1>
          <p>Por favor insira seu nome antes de continuar:</p>
          <input
            type="text"
            value={nomeJogador}
            onChange={(e) => setNomeJogador(e.target.value)}
          />

          <p>Escolha o seu personagem:</p>
          <div className="skin-opcoes">
            {skins.map((skin) => (
              <button
                key={skin.id}
                type="button"
                className={`botao-personagem ${skinId === skin.id ? "skin-selecionado" : ""}`}
                onClick={() => setSkinId(skin.id)}
              >
                <img
                  src={skin.imagem}
                  alt=""
                  className="imagem-personagem"
                />
              </button>
            ))}
          </div>

          <button
            onClick={() => {
              const skin = skins.find((s) => s.id === skinId);
              if (skin) setImagemJogador(skin.imagem);
              setStatusJogo("batalhando");
              gerarBatalha(1);
            }}
          >
            Começar
          </button>
        </div>
      )}

      {/* BATALHA */}
      {statusJogo === "batalhando" && (
        <div className="Tela_de_batalha">
          <div className="batalha-topo">
            <div className="oponente-info">
              <div className="oponente-nome">{nomeOponente || "Oponente"}</div>
              {barraDeVida(
                vidaOponente,
                inimigos[indiceOponenteAtual]?.vida * dificuldade || 1
              )}
            </div>

            <div className="rodada-display">Rodada: {rodada}</div>

            <div className="imagem-oponente-wrap">
              <div className="imagem-oponente">
                imagem oponente
              </div>

              {mostrarAtaqueVisual && (
                <div className="ataque-visual">
                  💥
                </div>
              )}
            </div>
          </div>

          <div className="batalha-centro">
            <div className="imagem-jogador">
              {imagemJogador ? (
                <img src={imagemJogador} alt={nomeJogador} />
              ) : (
                "imagem jogador"
              )}
            </div>
            <div style={{ flex: 1 }}></div>
          </div>

          <div className="batalha-inferior">
            <div className="comandos-coluna">
              {interfaceDeBatalha !== "vitoria" && interfaceDeBatalha !== "derrota" && (
                <>
                  {interfaceDeBatalha === "inicial" && turno === 0 && (
                    <div className="comandos-grid">
                      <button onClick={() => setInterfaceDeBatalha("atacar")}>
                        Ataques
                      </button>
                      <button onClick={() => setInterfaceDeBatalha("itens")}>
                        Itens
                      </button>
                      <button onClick={() => setInterfaceDeBatalha("recitar")}>
                        Recitar
                      </button>
                      <button disabled>
                        por enquanto não tem nada
                      </button>
                    </div>
                  )}

                  {interfaceDeBatalha === "atacar" && turno === 0 && (
                    <div className="comandos-lista">
                      <button onClick={() => atacar(ataqueBasico, "Soco")}>
                        Soco
                      </button>

                      {armaEquipada === "adaga primitiva" && armas.adagaPrimitiva.possui && (
                        <button onClick={() => atacar(armas.adagaPrimitiva.dano, "Corte Primitivo")}>
                          Corte Primitivo
                        </button>
                      )}

                      {armaEquipada === "adaga velha" && armas.adagaVelha.possui && (
                        <button onClick={() => atacar(armas.adagaVelha.dano, "Corte")}>
                          Corte
                        </button>
                      )}

                      <button onClick={() => setInterfaceDeBatalha("inicial")}>
                        Voltar
                      </button>
                    </div>
                  )}

                  {interfaceDeBatalha === "itens" && (
                    <div className="comandos-lista">
                      {cristais > 0 && (
                        <button onClick={usarCristal}>
                          Cristal de Cura ({cristais})
                        </button>
                      )}
                      <button onClick={() => setInterfaceDeBatalha("inicial")}>
                        Voltar
                      </button>
                    </div>
                  )}

                  {interfaceDeBatalha === "recitar" && turno === 0 && (
                    <div className="comandos-lista comandos-recitar">
                      <p>Recite o feitiço:</p>
                      <input
                        type="text"
                        value={palavraDigitada}
                        onChange={(e) => setPalavraDigitada(e.target.value)}
                        onKeyDown={(e) => {
                          if (e.key === "Enter") tentarRecitar();
                        }}
                        placeholder="Digite a palavra..."
                        autoFocus
                      />
                      <button onClick={tentarRecitar}>Recitar</button>
                      <button onClick={() => setInterfaceDeBatalha("inicial")}>
                        Voltar
                      </button>
                    </div>
                  )}
                </>
              )}
            </div>

            <div className="log-batalha">
              <div className="log-titulo">Log</div>
              {logAtaques.length === 0 ? (
                <p className="log-vazio">Aguardando ações...</p>
              ) : (
                logAtaques.map((log, index) => renderLogItem(log, index))
              )}
            </div>

            <div className="player-info">
              <div className="player-nome">{nomeJogador}</div>
              {barraDeVida(vidaJogador, vidaMaximaJogador)}

              <div className="player-extra">
                <div className="player-itens-linha">
                  <div className="item-equipado-slot">
                    {imagemArmaEquipada() ? (
                      <img
                        src={imagemArmaEquipada()}
                        alt="Arma equipada"
                        className="item-equipado-img"
                      />
                    ) : (
                      <span className="item-equipado-vazio">—</span>
                    )}
                  </div>

                  <div className="player-cristal-slot">
                    <img
                      src={imagemCristal}
                      alt="Cristal"
                      className="player-cristal-img"
                    />
                    <span className="player-cristal-qtd">{cristais}</span>
                  </div>
                </div>

                <div className="barra-mana-box">
                  <div className="mana-label">Mana</div>
                  {esferasDeMana()}
                </div>
              </div>
            </div>
          </div>

          {interfaceDeBatalha === "vitoria" && (
            <div className="overlay-resultado">
              <h1>Você venceu!</h1>
              <button
                onClick={() => {
                  setStatusJogo("lobby");
                  setInterfaceDeBatalha("inicial");
                  setTurno(0);
                  setRodada(0);
                  setLogAtaques([]);
                }}
              >
                Voltar para a vila
              </button>
            </div>
          )}

          {interfaceDeBatalha === "derrota" && (
            <div className="overlay-resultado">
              <h1>Você foi derrotado...</h1>
            </div>
          )}
        </div>
      )}

      {/* LOBBY */}
      {statusJogo === "lobby" && (
        <div className="tela_lobby">
          <p>{nomeJogador}</p>
          <p>Level: {levelJogador}</p>
          <p>Vida: {vidaJogador} / {vidaMaximaJogador}</p>
          <p>Moedas: {moedas}</p>
          <button onClick={() => setStatusJogo("casa")}>Casa</button>
          <button onClick={() => setStatusJogo("floresta")}>Floresta</button>
          <button onClick={() => setStatusJogo("loja")}>Loja</button>
        </div>
      )}

      {/* FLORESTA */}
      {statusJogo === "floresta" && (
        <div className="tela_floresta">
          <button onClick={() => setStatusJogo("lobby")}>Voltar</button>
          <p>O QUÃO FUNDO DEVO IR NA FLORESTA??</p>

          <button
            onClick={() => {
              setDificuldade(1);
              setStatusJogo("batalhando");
              gerarBatalha(randint(1, 2));
            }}
          >
            Bosque
          </button>

          <button
            onClick={() => {
              setDificuldade(2);
              setStatusJogo("batalhando");
              gerarBatalha(randint(1, 3));
            }}
          >
            Campo de pinheiros
          </button>

          <button
            onClick={() => {
              setDificuldade(3);
              setStatusJogo("batalhando");
              gerarBatalha(randint(3, 5));
            }}
          >
            Profundezas
          </button>
        </div>
      )}

      {/* CASA + GRIMÓRIO */}
      {statusJogo === "casa" && (
        <div>
          <div className="tela_casa">
            <button onClick={() => setStatusJogo("lobby")}>Voltar para aldeia</button>
            <p>Casa</p>
            <p>Dia: {dia}</p>
            <p>Vida: {vidaJogador}/{vidaMaximaJogador}</p>
            <button onClick={passarDia}>Descansar por hoje</button>
            <button onClick={() => setStatusJogo("casa-inventario")}>Inventário</button>
          </div>

          {grimorio && (
            <div className="tela_grimorio">
              <h2>Grimório</h2>
              <p>Feitiços aprendidos:</p>
              <ul>
                {Object.values(feiticos).filter((f) => f.aprendido).length === 0 ? (
                  <li>Nenhum feitiço aprendido ainda.</li>
                ) : (
                  Object.values(feiticos)
                    .filter((feitico) => feitico.aprendido)
                    .map((feitico) => (
                      <li key={feitico.nome}>
                        {feitico.nome} (Recitar: {feitico.recitar}, Custo de Mana: {feitico.custo_mana})
                      </li>
                    ))
                )}
              </ul>
            </div>
          )}
        </div>
      )}

      {/* INVENTÁRIO */}
      {statusJogo === "casa-inventario" && (
        <div className="tela_inventario">
          <button
            className="inventario-voltar"
            onClick={() => setStatusJogo("casa")}
          >
            Voltar
          </button>

          <div className="inventario-corpo">
            <div className="inventario-jogador">
              {imagemJogador ? (
                <img src={imagemJogador} alt={nomeJogador} />
              ) : (
                <span className="inventario-jogador-placeholder">
                  jogador<br />de frente
                </span>
              )}
            </div>

            <div className="inventario-direita">
              <div className="inventario-lista-armas">
                {armas.adagaPrimitiva.possui && (
                  <div className="inventario-item-linha">
                    <div className="inventario-item-img">
                      <img src={imagemAdagaPrimitiva} alt={armas.adagaPrimitiva.nome} />
                    </div>
                    <div className="inventario-item-info">
                      <div className="inventario-item-nome">{armas.adagaPrimitiva.nome}</div>
                      <div className="inventario-item-dano">
                        {armas.adagaPrimitiva.dano[0]} - {armas.adagaPrimitiva.dano[1]}
                      </div>
                    </div>
                    <button
                      className="inventario-btn-equipar"
                      onClick={() => setArmaEquipada("adaga primitiva")}
                      disabled={armaEquipada === "adaga primitiva"}
                    >
                      {armaEquipada === "adaga primitiva" ? "✓ Equipada" : "Equipar"}
                    </button>
                  </div>
                )}

                {armas.adagaVelha.possui && (
                  <div className="inventario-item-linha">
                    <div className="inventario-item-img">
                      <img src={imagemAdagaVelha} alt={armas.adagaVelha.nome} />
                    </div>
                    <div className="inventario-item-info">
                      <div className="inventario-item-nome">{armas.adagaVelha.nome}</div>
                      <div className="inventario-item-dano">
                        {armas.adagaVelha.dano[0]} - {armas.adagaVelha.dano[1]}
                      </div>
                    </div>
                    <button
                      className="inventario-btn-equipar"
                      onClick={() => setArmaEquipada("adaga velha")}
                      disabled={armaEquipada === "adaga velha"}
                    >
                      {armaEquipada === "adaga velha" ? "✓ Equipada" : "Equipar"}
                    </button>
                  </div>
                )}

                {!armas.adagaPrimitiva.possui && !armas.adagaVelha.possui && (
                  <p className="inventario-vazio">Nenhuma arma no inventário</p>
                )}
              </div>

              <div
                className={`inventario-cristais ${cristais > 0 ? "inventario-cristais-clicavel" : ""}`}
                onClick={usarCristalInventario}
                title={cristais > 0 ? "Clique para curar" : "Sem cristais"}
              >
                <div className="inventario-cristal-img">
                  <img src={imagemCristal} alt="Cristal de Cura" />
                </div>
                <div className="inventario-cristal-qtd">
                  <span className="inventario-cristal-label">quantidade</span>
                  <span className="inventario-cristal-valor">{cristais} cristais</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      )}

      {/* LOJA */}
      {statusJogo === "loja" && (
        <div className="tela_loja">
          <h1>Loja</h1>
          <p>
            Moedas: <strong>{moedas}</strong>
          </p>

          <button onClick={() => comprarItemAcumulavel(setCristais, 5, 1)}>
            <div>
              <figure>
                <img
                  src={imagemCristal}
                  alt="Cristal de Cura"
                  style={{ width: "24px", height: "24px", marginRight: "8px" }}
                />
                <p>Cristal de Cura (5 moedas)</p>
              </figure>
            </div>
          </button>

          {!armas.adagaVelha.possui && (
            <button onClick={() => comprarArma("adagaVelha", 10)}>
              <figure>
                <img
                  src={imagemAdagaVelha}
                  alt="Adaga Velha"
                  style={{ width: "24px", height: "24px", marginRight: "8px" }}
                />
                <p>Adaga Velha (10 moedas)</p>
              </figure>
            </button>
          )}

          {!grimorio && dia >= 3 && (
            <button
              onClick={() => {
                if (moedas >= 25) {
                  setMoedas((m) => m - 25);
                  setGrimorio(true);
                } else {
                  alert("Vendedor: Sem grana, sem itens");
                }
              }}
            >
              Grimório (25 moedas)
            </button>
          )}

          {grimorio && !feiticos.slimeSquad.aprendido && (
            <button onClick={() => comprarSpell("slimeSquad", 30)}>
              Pergaminho de Slimes (30 moedas)
            </button>
          )}

          <br />
          <br />
          <button onClick={() => setStatusJogo("lobby")}>Voltar</button>
        </div>
      )}
    </div>
  );
}

export default App;
