import { useState, useEffect } from 'react';
import './App.css';

function App() {

  // Game Manager
  const [rodada, setRodada] = useState(0);
  const [turno, setTurno] = useState(0);
  const [statusJogo, setStatusJogo] = useState("start");
  const [interfaceDeBatalha, setInterfaceDeBatalha] = useState("inicial");
  const [dia, setDia] = useState(0);
  const [logAtaques, setLogAtaques] = useState([]);

  // Múltiplos inimigos
  const [inimigosRestantes, setInimigosRestantes] = useState(1);

  //Móveis da casa
  const [camaLevel, setCamaLevel] = useState(1);
  const [recuperacaoCama] = useState([0, 0.35, 0.45, 0.6]);

  // Jogador
  const [nomeJogador, setNomeJogador] = useState("Guest");
  const [vidaJogador, setVidaJogador] = useState(20);
  const [vidaMaximaJogador, setVidaMaximaJogador] = useState(20);
  const [levelJogador, setLevelJogador] = useState(0);
  const [xpNecessario, setXpNecessario] = useState(5);
  const [xpAtual, setXpAtual] = useState(0);
  const [armaEquipada, setArmaEquipada] = useState("");
  const [manaJogador, setManaJogador] = useState(5)

  // Itens
  const [pocoes, setPocoes] = useState(3);
  const [moedas, setMoedas] = useState(5);

  // Itens de combate
  const [adagaVelha, setAdagaVelha] = useState(false);
  const [danoAdagaVelha, setDanoAdagaVelha] = useState([7, 11]);
  const [adagaVelhaEquipada, setAdagaVelhaEquipada] = useState(false);

  const [adagaPrimitiva, setAdagaPrimitiva] = useState(false);
  const [danoAdagaPrimitiva, setDanoAdagaPrimitiva] = useState([7, 12]);
  const [adagaPrimitivaEquipada, setAdagaPrimitivaEquipada] = useState(false);

  // Oponentes
  const [oponente] = useState(["lobo", "slime", "goblin", "Javali"]);
  const [vidaOponenteLista] = useState([15, 10, 18, 14, 20]);
  const [ataques1OponenteLista] = useState(["arranhão", "pancada", "soco rapido", "investida"]);
  const [ataques2OponenteLista] = useState(["mordida", "empurrão", "pancada", "Mordida"]);
  const [ataqueMin1OponenteLista] = useState([6, 4, 4, 5]);
  const [ataqueMax1OponenteLista] = useState([8, 5, 7, 9]);
  const [ataqueMin2OponenteLista] = useState([4, 2, 3, 4]);
  const [ataqueMax2OponenteLista] = useState([7, 3, 4, 7]);
  const [dropMoedasMaxLista] = useState([10, 8, 15, 2]);
  const [dropRaroLista] = useState(["", "cristal de cura", "adaga primitiva", ""]);
  const [chanceDropRaro] = useState(["", "8", "8", ""]);
  const [dropXPLista] = useState([2, 1, 2, 2]);

  // Oponente atual
  const [nomeOponente, setNomeOponente] = useState("");
  const [vidaOponente, setVidaOponente] = useState(1);
  const [indiceOponenteAtual, setIndiceOponenteAtual] = useState(0);
  const [dificuldade, setDificuldade] = useState(1);

  // Ataques do jogador
  const [ataque1] = useState([5, 10]);


  // ==================== FUNÇÕES ====================
  function randint(min, max) {
    return Math.floor(Math.random() * (max - min + 1)) + min;
  }

  function wait(tempo) {
    return new Promise((resolve) => setTimeout(resolve, tempo * 1000));
  }

  // ==================== BARRA DE VIDA ====================
  function barraDeVida(vidaAtual, vidaMaxima) {
    const max = vidaMaxima || 1;
    const porcentagem = Math.max(0, Math.min(100, (vidaAtual / max) * 100));
    
    return (
      <div style={{ display: "flex", alignItems: "center", gap: "10px", margin: "8px 0" }}>
        <div style={{
          width: "250px",
          height: "24px",
          backgroundColor: "#1f2937",
          border: "2px solid #4b5563",
          borderRadius: "6px",
          overflow: "hidden"
        }}>
          <div style={{
            width: `${porcentagem}%`,
            height: "100%",
            backgroundColor: vidaAtual > max * 0.35 ? "#22c55e" : "#ef4444",
            transition: "width 0.4s ease"
          }} />
        </div>
        <span style={{ fontFamily: "monospace", minWidth: "85px" }}>
          {vidaAtual} / {max}
        </span>
      </div>
    );
  }

  function gerarBatalha(quantidade = 1) {
    const indice = randint(0, 2);
    
    setIndiceOponenteAtual(indice);
    setInimigosRestantes(quantidade);
    setNomeOponente(oponente[indice]);
    setVidaOponente(vidaOponenteLista[indice] * dificuldade);
    setTurno(0);
    setInterfaceDeBatalha("inicial");
  }

  function mudarTurno() {
    setTurno((atual) => (atual === 0 ? 1 : 0));
  }

  // ==================== ATAQUES ====================
  function inimigoAtacar() {
    if (vidaJogador <= 0 || vidaOponente <= 0) return;

    const escolhaAtaque = randint(1, 2);
    let dano = 0;
    let nomeAtaque = "";

    if (escolhaAtaque === 1) {
      dano = randint(ataqueMin1OponenteLista[indiceOponenteAtual], ataqueMax1OponenteLista[indiceOponenteAtual]);
      nomeAtaque = ataques1OponenteLista[indiceOponenteAtual];
    } else {
      dano = randint(ataqueMin2OponenteLista[indiceOponenteAtual], ataqueMax2OponenteLista[indiceOponenteAtual]);
      nomeAtaque = ataques2OponenteLista[indiceOponenteAtual];
    }

    setLogAtaques((log) => [...log, `${nomeOponente} usou ${nomeAtaque}`]);

    setVidaJogador((vidaAtual) => Math.max(0, vidaAtual - dano));
    setInterfaceDeBatalha("esperando");

    wait(1).then(() => {
      if (vidaJogador > 0) {
        mudarTurno();
        setInterfaceDeBatalha("inicial");
      }
    });
  }

  function darDrops(indiceOponenteAtual) {
    const indice = indiceOponenteAtual;
    const DropMoedas = randint(3, dropMoedasMaxLista[indice]);
    const xpDropado = randint(1, dropXPLista[indice]);

    setMoedas(moedas => moedas + DropMoedas);
    setXpAtual((xp) => xp + xpDropado);

    setLogAtaques(log => [...log, `${DropMoedas} moedas e ${xpDropado} XP`]);

    const chance = chanceDropRaro[indice];
    if (chance > 0 && randint(1, 10) <= chance) {
      const itemDropado = dropRaroLista[indice];

      if (itemDropado === "adaga primitiva" && !adagaPrimitiva) {
        setAdagaPrimitiva(true);
        setLogAtaques(log => [...log, "Você encontrou uma Adaga primitiva!!"]);
      } else if (itemDropado === "cristal de cura") {
        setPocoes(p => p + 1);
        setLogAtaques(log => [...log, "você encontra um cristal de cura!!"]);
      }
    }
  }

  function atacar(vidaAlvo, setVidaAlvo, ataque, nomeDoAtaque) {
    const danoCausado = randint(ataque[0], ataque[1]);

    setLogAtaques((log) => [...log, `${nomeJogador} usou ${nomeDoAtaque}`]);

    setVidaAlvo((vidaAtual) => Math.max(0, vidaAtual - danoCausado));
    setInterfaceDeBatalha("esperando");

    wait(1).then(() => {
      mudarTurno();
      setRodada((rodadaAtual) => rodadaAtual + 1);

      if (vidaOponente - danoCausado > 0 && vidaJogador > 0) {
        inimigoAtacar();
      }
    });
  }

  function usarPocao() {
    if (pocoes <= 0) return;

    const cura = randint(10, 20);
    
    setVidaJogador((vidaAtual) => Math.min(vidaAtual + cura, vidaMaximaJogador));
    setPocoes((p) => p - 1);
    
    setInterfaceDeBatalha("esperando");
    setLogAtaques((log) => [...log, `${nomeJogador} usou uma Poção (+${cura} HP)`]);

    wait(0.8).then(() => {
      mudarTurno();
      if (vidaJogador > 0 && vidaOponente > 0) {
        inimigoAtacar();
      } else {
        setInterfaceDeBatalha("inicial");
      }
    });
  }

  function passarDia() {
    setDia((diaAtual) => diaAtual + 1);
    setVidaJogador((vidaAtual) => {
      const multiplicador = recuperacaoCama[camaLevel] || 1.0;
      const vidaParaRecuperar = Math.floor(vidaMaximaJogador * multiplicador);
      return Math.min(vidaAtual + vidaParaRecuperar, vidaMaximaJogador);
    });
  }

  function upgradeCama(camaLevel, setCamaLevel, setMoedas, preco, moedasAtuais) {
    if (moedasAtuais >= preco) {
      setMoedas((moedas) => moedas - preco);
      setCamaLevel((camaLevel) => camaLevel + 1);
    } else {
      alert("Vendedor: Sem grana, sem itens");
    }
  }

  function comprarItemAcumulavel(setItem, setMoedas, preco, quantidade, moedasAtuais) {
    if (moedasAtuais >= preco) {
      setMoedas(m => m - preco);
      setItem(i => i + quantidade);
    } else {
      alert("Sem grana suficiente!");
    }
  }

  function comprarEspada(espada, setEspada, setMoedas, preco, moedasAtuais) {
    if (moedasAtuais >= preco) {
      setMoedas((moedas) => moedas - preco);
      setEspada(true)
    } else {
      alert("Vendedor: Sem grana, sem itens");
    }
  }

  // ==================== EFFECTS ====================
  useEffect(() => {
    if (xpAtual >= xpNecessario && xpNecessario > 0) {
      setLevelJogador((level) => level + 1);
      setVidaMaximaJogador((vida) => Math.floor(vida * 1.2));
      setXpNecessario((xp) => Math.floor(xp * 1.5));
      setXpAtual(0);
    }
  }, [xpAtual, vidaJogador, xpNecessario]);

  useEffect(() => {
    if (vidaOponente <= 0 && vidaJogador > 0) {
      darDrops(indiceOponenteAtual);

      if (inimigosRestantes > 1) {
        setInimigosRestantes((q) => q - 1);
        setTimeout(() => {
          const indice = randint(0, 2);
          setIndiceOponenteAtual(indice);
          setNomeOponente(oponente[indice]);
          setVidaOponente(vidaOponenteLista[indice] * dificuldade);
          setTurno(0);
          setInterfaceDeBatalha("inicial");
          setLogAtaques((log) => [...log, `✦ Um novo ${oponente[indice]} apareceu! ✦`]);
        }, 1000);
      } else {
        setInterfaceDeBatalha("vitoria");
        setTurno(0);
      }
    } else if (vidaJogador <= 0) {
      setInterfaceDeBatalha("derrota");
      setTurno(0);
    }
  }, [vidaOponente, vidaJogador]);

  // ==================== JSX ====================
  return (
    <div className="App">
      {statusJogo === "start" && (
        <div className="tela_inicial">
          <h1>Bem-vindo(a)!</h1>
          <p>Por favor insira seu nome antes de continuar:</p>
          <input
            type="text"
            value={nomeJogador}
            onChange={(e) => setNomeJogador(e.target.value)}
          />
          <button onClick={() => {
            setStatusJogo("batalhando");
            gerarBatalha(1);
          }}>
            Começar
          </button>
        </div>
      )}

      {/* ===================== BATALHA ===================== */}
      {statusJogo === "batalhando" && (
        <div className="Tela_de_batalha">

          <div className="arena">
            
            {/* Lado do Inimigo */}
            <div className="area_inimigo">
              <div className="informacoes_inimigo">
                <p className="nome_inimigo">{nomeOponente}</p>
                {barraDeVida(vidaOponente, vidaOponenteLista[indiceOponenteAtual] * dificuldade)}
              </div>
            </div>

            {/* Lado do Jogador */}
            <div className="area_player">
              <div className="informacoes_player">
                <p className="nome_player">{nomeJogador}</p>
                {barraDeVida(vidaJogador, vidaMaximaJogador)}
              </div>
            </div>
          </div>

          {/* Caixa de Comandos e Log */}
          <div className="interface_batalha">
            {interfaceDeBatalha !== "vitoria" && interfaceDeBatalha !== "derrota" && (
              <>
                {interfaceDeBatalha === "inicial" && turno === 0 && (
                  <div className="comandos">
                    <button onClick={() => setInterfaceDeBatalha("atacar")}>ATACAR</button>
                    <button onClick={() => setInterfaceDeBatalha("itens")}>ITENS</button>
                  </div>
                )}

                {interfaceDeBatalha === "atacar" && turno === 0 && (
                  <div className="comandos_ataques">
                    <button onClick={() => atacar(vidaOponente, setVidaOponente, ataque1, "Soco")}>Soco</button>
                    
                    {armaEquipada === "adaga primitiva" && (
                      <button onClick={() => atacar(vidaOponente, setVidaOponente, danoAdagaPrimitiva, "Corte Primitivo")}>
                        Corte Primitivo
                      </button>
                    )}

                    {armaEquipada === "adaga velha" && (
                      <button onClick={() => atacar(vidaOponente, setVidaOponente, danoAdagaVelha, "Corte")}>
                        Corte
                      </button>
                    )}

                    <button onClick={() => setInterfaceDeBatalha("inicial")}>Voltar</button>
                  </div>
                )}

                {interfaceDeBatalha === "itens" && (
                  <div className="comandos_itens">
                    {pocoes > 0 && <button onClick={usarPocao}>Poção ({pocoes})</button>}
                    <button onClick={() => setInterfaceDeBatalha("inicial")}>Voltar</button>
                  </div>
                )}

                <div className="log_batalha">
                  <h4>Log</h4>
                  {logAtaques.map((log, index) => (
                    <p key={index}>{log}</p>
                  ))}
                </div>
              </>
            )}

            {interfaceDeBatalha === "vitoria" && (
              <div className="resultado_vitoria">
                <h1>Você venceu!</h1>
                <button onClick={() => {
                  setStatusJogo("lobby");
                  setInterfaceDeBatalha("inicial");
                  setTurno(0);
                  setRodada(0);
                  setLogAtaques([]);
                }}>
                  Voltar para a vila
                </button>
              </div>
            )}

            {interfaceDeBatalha === "derrota" && (
              <div className="resultado_derrota">
                <h1>Você foi derrotado...</h1>
              </div>
            )}
          </div>
        </div>
      )}

      {/* LOBBY */}
      {statusJogo === "lobby" && (
        <div className="tela_lobby">
          <p>{nomeJogador}</p>
          <p>Level: {levelJogador}</p>
          <p>Vida: {vidaJogador} / {vidaMaximaJogador}</p>
          <p>Moedas: {moedas}</p>
          <button onClick={() => setStatusJogo("casa")}>Casa</button>
          <button onClick={() => setStatusJogo("floresta")}>Floresta</button>
          <button onClick={() => setStatusJogo("loja")}>Loja</button>
        </div>
      )}

      {/* FLORESTA */}
      {statusJogo === "floresta" && (
        <div className="tela_floresta">
          <button onClick={() => setStatusJogo("lobby")}>Voltar</button>
          <p>O QUÃO FUNDO DEVO IR NA FLORESTA??</p>
          <button onClick={() => { setDificuldade(1); setStatusJogo("batalhando"); gerarBatalha(randint(1,2)); }}>Bosque</button>
          <button onClick={() => { setDificuldade(2); setStatusJogo("batalhando"); gerarBatalha(randint(1,3)); }}>Campo de pinheiros</button>
          <button onClick={() => { setDificuldade(3); setStatusJogo("batalhando"); gerarBatalha(randint(3,5)); }}>Profundezas</button>
        </div>
      )}

      {/* CASA */}
      {statusJogo === "casa" && (
        <div className="tela_casa">
          <button onClick={() => setStatusJogo("lobby")}>Voltar para aldeia</button>
          <p>Casa</p>
          <p>Dia: {dia}</p>
          <p>Vida: {vidaJogador}/{vidaMaximaJogador}</p>
          <button onClick={passarDia}>Descansar por hoje</button>
          <button onClick={() => setStatusJogo("casa-inventario")}>Inventario</button>
        </div>
      )}

      {/* INVENTÁRIO */}
      {statusJogo === "casa-inventario" && (
        <div className="tela_inventario">
          <button onClick={() => setStatusJogo("casa")}>Voltar</button>
          <h2>Inventário</h2>

          {adagaPrimitiva && (
            <div>
              <p><strong>Adaga Primitiva</strong> - Dano: {danoAdagaPrimitiva[0]}-{danoAdagaPrimitiva[1]}</p>
              <button 
                onClick={() => setArmaEquipada("adaga primitiva")}
                disabled={armaEquipada === "adaga primitiva"}
              >
                {armaEquipada === "adaga primitiva" ? "✓ Equipada" : "Equipar"}
              </button>
            </div>
          )}

          {adagaVelha && (
            <div>
              <p><strong>Adaga Velha</strong> - Dano: {danoAdagaVelha[0]}-{danoAdagaVelha[1]}</p>
              <button 
                onClick={() => setArmaEquipada("adaga velha")}
                disabled={armaEquipada === "adaga velha"}
              >
                {armaEquipada === "adaga velha" ? "✓ Equipada" : "Equipar"}
              </button>
            </div>
          )}
        </div>
      )}

      {/* LOJA */}
      {statusJogo === "loja" && (
        <div className="tela_loja">
          <h1>Loja</h1>
          <p>Moedas: <strong>{moedas}</strong></p>
          
          <button onClick={() => comprarItemAcumulavel(setPocoes, setMoedas, 5, 1, moedas)}>
            Comprar Poção (5 moedas)
          </button>

          {!adagaVelha && (
            <button onClick={() => comprarEspada(adagaVelha, setAdagaVelha, setMoedas, 10, moedas)}>
              Adaga Velha (10 moedas)
            </button>
          )}

          <br/><br/>
          <button onClick={() => setStatusJogo("lobby")}>Voltar</button>
        </div>
      )}
    </div>
  );
}

export default App;   // ← ESSA LINHA ERA A PRINCIPAL FALTA
