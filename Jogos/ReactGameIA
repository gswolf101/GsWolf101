      if (pertoDe === "acampamento") {
        setDificuldade(2);
        setStatusJogo("batalhando");
        gerarBatalhaGoblin(randint(2, 3));
      }
      if (pertoDe === "templo") {
        setDificuldade(3);
        setStatusJogo("batalhando");
        gerarBatalhaGoblin(randint(3, 5));
      }
    }

    // CASA
    if (statusJogo === "casa") {
      if (pertoDe === "voltar") setStatusJogo("lobby");
      if (pertoDe === "descansar") passarDia();
