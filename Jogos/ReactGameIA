            FLORESTA
          </div>

          <Zona id="voltar" x={80} y={80} label="← Voltar" cor="#4a5568" />
          <Zona id="bosque" x={200} y={320} label="Bosque" cor="#276749" />
          <Zona id="pinheiros" x={400} y={320} label="Pinheiros" cor="#22543d" />
          <Zona id="profundezas" x={600} y={320} label="Profundezas" cor="#1a202c" />

          <JogadorMovel />

          <div style={{
            position: "absolute", bottom: 12, left: 20, color: "rgba(255,255,255,0.7)", fontSize: 13
          }}>
            WASD / Setas • E para interagir
          </div>
        </div>
      )}

      {/* ==================== ALDEIA GOBLIN ==================== */}
      {statusJogo === "aldeiaGoblin" && (
        <div className="tela_exploravel" style={{
          position: "relative",
          width: "800px",
          height: "600px",
          margin: "0 auto",
          backgroundColor: "#742a2a",
          border: "4px solid #9b2c2c",
          overflow: "hidden"
        }}>
          <div style={{ position: "absolute", top: 15, left: 20, color: "white", fontSize: 18, fontWeight: "bold" }}>
            ALDEIA DOS GOBLINS
          </div>

          <Zona id="voltar" x={80} y={80} label="← Voltar" cor="#4a5568" />
          <Zona id="entrada" x={200} y={320} label="Entrada" cor="#c53030" />
          <Zona id="acampamento" x={400} y={320} label="Acampamento" cor="#9b2c2c" />
          <Zona id="templo" x={600} y={320} label="Templo do Xamã" cor="#742a2a" />

          <JogadorMovel />

          <div style={{
            position: "absolute", bottom: 12, left: 20, color: "rgba(255,255,255,0.7)", fontSize: 13
          }}>
            WASD / Setas • E para interagir
          </div>
        </div>
      )}

      {/* ==================== CASA ==================== */}
      {statusJogo === "casa" && (
        <div className="tela_exploravel" style={{
          position: "relative",
          width: "800px",
          height: "600px",
          margin: "0 auto",
          backgroundColor: "#744210",
          border: "4px solid #975a16",
          overflow: "hidden"
        }}>
          <div style={{ position: "absolute", top: 15, left: 20, color: "white" }}>
            <div style={{ fontSize: 18, fontWeight: "bold" }}>Casa</div>
            <div>Dia: {dia} | Vida: {vidaJogador}/{vidaMaximaJogador}</div>
          </div>

          <Zona id="voltar" x={80} y={80} label="← Voltar" cor="#4a5568" />
          <Zona id="descansar" x={280} y={280} label="🛏️ Descansar" cor="#975a16" />
          <Zona id="inventario" x={520} y={280} label="🎒 Inventário" cor="#2b6cb0" />

          {grimorio && (
            <div style={{
              position: "absolute",
              right: 20,
              top: 80,
              background: "rgba(0,0,0,0.6)",
              padding: 12,
              borderRadius: 8,
              color: "white",
              maxWidth: 220
            }}>
              <strong>Grimório</strong>
              <ul style={{ margin: "8px 0 0 0", paddingLeft: 18, fontSize: 13 }}>
                {Object.values(feiticos).filter(f => f.aprendido).length === 0 ? (
                  <li>Nenhum feitiço</li>
                ) : (
                  Object.values(feiticos)
                    .filter(f => f.aprendido)
                    .map(f => <li key={f.nome}>{f.nome}</li>)
                )}
              </ul>
            </div>
          )}

          <JogadorMovel />

          <div style={{
            position: "absolute", bottom: 12, left: 20, color: "rgba(255,255,255,0.7)", fontSize: 13
          }}>
            WASD / Setas • E para interagir
          </div>
        </div>
      )}

      {/* INVENTÁRIO */}
      {statusJogo === "casa-inventario" && (
        <div className="tela_inventario">
          <button className="inventario-voltar" onClick={() => setStatusJogo("casa")}>
            Voltar
          </button>

          <div className="inventario-corpo">
            <div className="inventario-jogador">
              {imagemJogador ? (
                <img src={imagemJogador} alt={nomeJogador} />
              ) : (
                <span className="inventario-jogador-placeholder">jogador<br />de frente</span>
              )}
            </div>

            <div className="inventario-direita">
              <div className="inventario-lista-armas">
                {armas.adagaPrimitiva.possui && (
                  <div className="inventario-item-linha">
                    <div className="inventario-item-img">
                      <img src={imagemAdagaPrimitiva} alt={armas.adagaPrimitiva.nome} />
                    </div>
                    <div className="inventario-item-info">
                      <div className="inventario-item-nome">{armas.adagaPrimitiva.nome}</div>
                      <div className="inventario-item-dano">
                        {armas.adagaPrimitiva.dano[0]} - {armas.adagaPrimitiva.dano[1]}
                      </div>
                      <div className="inventario-item-tipo">
                        Tipo: {armas.adagaPrimitiva.tipoHit}
                      </div>
                    </div>
                    <button
                      className="inventario-btn-equipar"
                      onClick={() => setArmaEquipada("adaga primitiva")}
                      disabled={armaEquipada === "adaga primitiva"}
                    >
                      {armaEquipada === "adaga primitiva" ? "✓ Equipada" : "Equipar"}
                    </button>
                  </div>
                )}

                {armas.adagaVelha.possui && (
                  <div className="inventario-item-linha">
                    <div className="inventario-item-img">
                      <img src={imagemAdagaVelha} alt={armas.adagaVelha.nome} />
                    </div>
                    <div className="inventario-item-info">
                      <div className="inventario-item-nome">{armas.adagaVelha.nome}</div>
                      <div className="inventario-item-dano">
                        {armas.adagaVelha.dano[0]} - {armas.adagaVelha.dano[1]}
                      </div>
                      <div className="inventario-item-tipo">
                        Tipo: {armas.adagaVelha.tipoHit}
                      </div>
                    </div>
                    <button
                      className="inventario-btn-equipar"
                      onClick={() => setArmaEquipada("adaga velha")}
                      disabled={armaEquipada === "adaga velha"}
                    >
                      {armaEquipada === "adaga velha" ? "✓ Equipada" : "Equipar"}
                    </button>
                  </div>
                )}

                {!armas.adagaPrimitiva.possui && !armas.adagaVelha.possui && (
                  <p className="inventario-vazio">Nenhuma arma no inventário</p>
                )}
              </div>

              <div
                className={`inventario-cristais ${cristais > 0 ? "inventario-cristais-clicavel" : ""}`}
                onClick={usarCristalInventario}
                title={cristais > 0 ? "Clique para curar" : "Sem cristais"}
              >
                <div className="inventario-cristal-img">
                  <img src={imagemCristal} alt="Cristal de Cura" />
                </div>
                <div className="inventario-cristal-qtd">
                  <span className="inventario-cristal-label">quantidade</span>
                  <span className="inventario-cristal-valor">{cristais} cristais</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      )}

      {/* ==================== LOJA ==================== */}
      {statusJogo === "loja" && (
        <div className="tela_loja">
          <button className="loja-voltar" onClick={() => setStatusJogo("lobby")}>
            voltar
          </button>

          <div className="loja-header">
            <h1>Loja</h1>
            <p className="loja-moedas">Moedas: <strong>{moedas}</strong></p>
          </div>

          <div className="loja-conteudo">
            <div className="loja-vendedor">
              <div className="loja-vendedor-img">
                <div className="vendedor-placeholder">imagem<br />vendedor</div>
              </div>
              <div className="loja-vendedor-nome">Vendedor da Vila</div>
            </div>

            <div className="loja-itens-scroll">
              {/* Cristal */}
              <div className="loja-item">
                <div className="loja-item-img">
                  <img src={imagemCristal} alt="Cristal de Cura" />
                </div>
                <div className="loja-item-info">
                  <div className="loja-item-nome">Cristal de Cura</div>
                  <div className="loja-item-desc">Recupera entre 10 e 20 de vida</div>
                </div>
                <button
                  className="loja-item-btn"
                  onClick={() => comprarItemAcumulavel(setCristais, 5, 1)}
                >
                  5 moedas / Comprar
                </button>
              </div>

              {/* Vara de Pesca */}
              {!varaPesca && (
                <div className="loja-item">
                  <div className="loja-item-img">
                    <div className="item-placeholder">🎣</div>
                  </div>
                  <div className="loja-item-info">
                    <div className="loja-item-nome">Vara de Pesca</div>
                    <div className="loja-item-desc">Permite pescar no lago da vila</div>
                  </div>
                  <button
                    className="loja-item-btn"
                    onClick={() => desbloquearItem(setVaraPesca, 20)}
                  >
                    20 moedas / Comprar
                  </button>
                </div>
              )}

              {/* Camas */}
              {camaLevel === 0 && (
                <div className="loja-item">
                  <div className="loja-item-img">
                    <div className="item-placeholder">🛏️</div>
                  </div>
                  <div className="loja-item-info">
                    <div className="loja-item-nome">Cama de Palha</div>
                    <div className="loja-item-desc">Recupera 35% da vida ao descansar</div>
                  </div>
                  <button className="loja-item-btn" onClick={() => upgradeCama(5)}>
                    5 moedas / Comprar
                  </button>
                </div>
              )}

              {camaLevel === 1 && (
                <div className="loja-item">
                  <div className="loja-item-img">
                    <div className="item-placeholder">🛏️</div>
                  </div>
                  <div className="loja-item-info">
                    <div className="loja-item-nome">Cama de Fibras</div>
                    <div className="loja-item-desc">Recupera 45% da vida ao descansar</div>
                  </div>
                  <button className="loja-item-btn" onClick={() => upgradeCama(15)}>
                    15 moedas / Comprar
                  </button>
                </div>
              )}

              {camaLevel === 2 && (
                <div className="loja-item">
                  <div className="loja-item-img">
                    <div className="item-placeholder">🛏️</div>
                  </div>
                  <div className="loja-item-info">
                    <div className="loja-item-nome">Cama de Pano</div>
                    <div className="loja-item-desc">Recupera 60% da vida ao descansar</div>
                  </div>
                  <button className="loja-item-btn" onClick={() => upgradeCama(20)}>
                    20 moedas / Comprar
                  </button>
                </div>
              )}

              {camaLevel === 3 && (
                <div className="loja-item">
                  <div className="loja-item-img">
                    <div className="item-placeholder">🛏️</div>
                  </div>
                  <div className="loja-item-info">
                    <div className="loja-item-nome">Cama de Lã</div>
                    <div className="loja-item-desc">Melhor cama disponível</div>
                  </div>
                  <button className="loja-item-btn" disabled>
                    Máximo atingido
                  </button>
                </div>
              )}

              {/* Adaga Velha */}
              {!armas.adagaVelha.possui && (
                <div className="loja-item">
                  <div className="loja-item-img">
                    <img src={imagemAdagaVelha} alt="Adaga Velha" />
                  </div>
                  <div className="loja-item-info">
                    <div className="loja-item-nome">Adaga Velha</div>
                    <div className="loja-item-desc">Dano 7-11 • Tipo: corte</div>
                  </div>
                  <button
                    className="loja-item-btn"
                    onClick={() => comprarArma("adagaVelha", 10)}
                  >
                    10 moedas / Comprar
                  </button>
                </div>
              )}

              {/* Mapa */}
              {!mapaAldeiaGoblin && levelJogador >= 3 && (
                <div className="loja-item">
                  <div className="loja-item-img">
                    <div className="item-placeholder">🗺️</div>
                  </div>
                  <div className="loja-item-info">
                    <div className="loja-item-nome">Mapa da Aldeia dos Goblins</div>
                    <div className="loja-item-desc">Desbloqueia uma nova área</div>
                  </div>
                  <button
                    className="loja-item-btn"
                    onClick={() => desbloquearItem(setMapaAldeiaGoblin, 25)}
                  >
                    25 moedas / Comprar
                  </button>
                </div>
              )}

              {/* Grimório */}
              {!grimorio && dia >= 3 && (
                <div className="loja-item">
                  <div className="loja-item-img">
                    <div className="item-placeholder">📖</div>
                  </div>
                  <div className="loja-item-info">
                    <div className="loja-item-nome">Grimório</div>
                    <div className="loja-item-desc">Necessário para aprender feitiços</div>
                  </div>
                  <button
                    className="loja-item-btn"
                    onClick={() => desbloquearItem(setGrimorio, 25)}
                  >
                    25 moedas / Comprar
                  </button>
                </div>
              )}

              {/* Pergaminho de Slimes */}
              {grimorio && !feiticos.slimeSquad.aprendido && (
                <div className="loja-item">
                  <div className="loja-item-img">
                    <div className="item-placeholder">📜</div>
                  </div>
                  <div className="loja-item-info">
                    <div className="loja-item-nome">Pergaminho de Slimes</div>
                    <div className="loja-item-desc">Aprende o feitiço Slime Squad</div>
                  </div>
                  <button
                    className="loja-item-btn"
                    onClick={() => comprarSpell("slimeSquad", 30)}
                  >
                    30 moedas / Comprar
                  </button>
                </div>
              )}
            </div>
          </div>
        </div>
      )}
    </div>
  );
}

export default App;
