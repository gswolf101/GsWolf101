    }

    if (statusJogo === "casa") {
      zonas = [
        { id: "voltar", x: 80, y: 80, raio: 55 },
        { id: "descansar", x: 280, y: 280, raio: 65 },
        { id: "inventario", x: 520, y: 280, raio: 65 },
      ];
    }

    let encontrado = null;
    for (const zona of zonas) {
      if (zona.id === "aldeiaGoblin" && !mapaAldeiaGoblin) continue;
      if (zona.id === "lago" && !varaPesca) continue;

      const dx = playerPos.x - zona.x;
      const dy = playerPos.y - zona.y;
      const distancia = Math.sqrt(dx * dx + dy * dy);

      if (distancia < zona.raio) {
        encontrado = zona.id;
        break;
      }
    }

    setPertoDe(encontrado);
  }, [playerPos, statusJogo, mapaAldeiaGoblin, varaPesca, podeAndar]);

