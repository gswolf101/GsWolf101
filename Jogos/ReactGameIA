  // Teclas
  useEffect(() => {
    if (!podeAndar) return;

    const handleKeyDown = (e) => {
      const key = e.key;
      if (["w", "a", "s", "d", "ArrowUp", "ArrowDown", "ArrowLeft", "ArrowRight"].includes(key)) {
        e.preventDefault();
        setKeys((prev) => ({ ...prev, [key]: true }));
      }
      if (e.key.toLowerCase() === "e") {
        interagir();
      }
    };

    const handleKeyUp = (e) => {
      const key = e.key;
      if (["w", "a", "s", "d", "ArrowUp", "ArrowDown", "ArrowLeft", "ArrowRight"].includes(key)) {
        setKeys((prev) => ({ ...prev, [key]: false }));
      }
    };

    window.addEventListener("keydown", handleKeyDown);
    window.addEventListener("keyup", handleKeyUp);
    return () => {
      window.removeEventListener("keydown", handleKeyDown);
      window.removeEventListener("keyup", handleKeyUp);
    };
  }, [podeAndar, pertoDe, statusJogo, mapaAldeiaGoblin, varaPesca]);

  // Loop de movimento do jogador
  useEffect(() => {
    if (!podeAndar) return;

    let animationId;
    const mover = () => {
      const velocidade = 3.8;

      setPlayerPos((pos) => {
        let novoX = pos.x;
        let novoY = pos.y;
        let novaDir = playerDir;

        if (keys.w || keys.ArrowUp) { novoY -= velocidade; novaDir = "cima"; }
        if (keys.s || keys.ArrowDown) { novoY += velocidade; novaDir = "baixo"; }
        if (keys.a || keys.ArrowLeft) { novoX -= velocidade; novaDir = "esquerda"; }
        if (keys.d || keys.ArrowRight) { novoX += velocidade; novaDir = "direita"; }

        novoX = Math.max(40, Math.min(760, novoX));
        novoY = Math.max(40, Math.min(560, novoY));

        setPlayerDir(novaDir);
        return { x: novoX, y: novoY };
      });

      animationId = requestAnimationFrame(mover);
    };

    animationId = requestAnimationFrame(mover);
    return () => cancelAnimationFrame(animationId);
  }, [keys, podeAndar, playerDir]);

  // Loop da bola de pesca + barra
  useEffect(() => {
    if (statusJogo !== "pescando") return;

    let animationId;

    const atualizarPesca = () => {
      // Move a bola
      setBolaPesca((pos) => {
        let novoX = pos.x + bolaDir.x;
        let novoY = pos.y + bolaDir.y;
        let novaDirX = bolaDir.x;
        let novaDirY = bolaDir.y;

        // Quica nas bordas
        if (novoX < 60 || novoX > 740) {
          novaDirX = -novaDirX;
          novoX = Math.max(60, Math.min(740, novoX));
        }
        if (novoY < 60 || novoY > 540) {
          novaDirY = -novaDirY;
          novoY = Math.max(60, Math.min(540, novoY));
        }

        setBolaDir({ x: novaDirX, y: novaDirY });
        return { x: novoX, y: novoY };
      });

      // Verifica se o jogador está dentro da bola
      setBarraPesca((barra) => {
        const dx = playerPos.x - bolaPesca.x;
        const dy = playerPos.y - bolaPesca.y;
        const distancia = Math.sqrt(dx * dx + dy * dy);
        const raioBola = 55;

        let novaBarra = barra;
        if (distancia < raioBola) {
          novaBarra = Math.min(100, barra + 0.35); // sobe
        } else {
          novaBarra = Math.max(0, barra - 0.18); // desce lentamente
        }

        // Vitória na pesca
        if (novaBarra >= 100) {
          const xpGanho = randint(3, 7);
          setXpAtual((xp) => xp + xpGanho);
          setTimeout(() => {
            alert(`Você pescou algo! +${xpGanho} XP`);
            setStatusJogo("lobby");
            setBarraPesca(0);
          }, 100);
          return 100;
        }

        return novaBarra;
      });

      animationId = requestAnimationFrame(atualizarPesca);
    };

    animationId = requestAnimationFrame(atualizarPesca);
    return () => cancelAnimationFrame(animationId);
  }, [statusJogo, bolaDir, playerPos, bolaPesca]);

  // Detectar zonas
  useEffect(() => {
