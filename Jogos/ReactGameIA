    if (statusJogo === "floresta") {
      zonas = [
        { id: "voltar", x: 80, y: 80, raio: 55 },
        { id: "bosque", x: 200, y: 320, raio: 65 },
        { id: "pinheiros", x: 400, y: 320, raio: 65 },
        { id: "profundezas", x: 600, y: 320, raio: 65 },
      ];
    }

    if (statusJogo === "aldeiaGoblin") {
      zonas = [
        { id: "voltar", x: 80, y: 80, raio: 55 },
        { id: "entrada", x: 200, y: 320, raio: 65 },
