  // ==================== INIMIGOS ALDEIA GOBLIN ====================
  const [inimigosAldeiaGoblin] = useState([
    {
      nome: "Goblin",
      imagem: imagemGoblin,
      vida: 18,
      ataques: [
        { nome: "Soco Rápido", minimo: 4, maximo: 7 },
        { nome: "Pancada", minimo: 3, maximo: 4 }
      ],
